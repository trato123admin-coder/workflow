# Copiar a .env.local (web) y a las variables de entorno de Render (engine). NUNCA commitear valores reales.
# Solo nombres: los valores se configuran en Vercel, Render o el archivo local ignorado por git.

# --- Web (Vercel) --- las NEXT_PUBLIC_* son visibles en el navegador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENGINE_URL=

# --- Engine (Render) --- SOLO en el servidor. Nunca en la web
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
ENGINE_TICK_SECRET=
ENGINE_ALLOWED_ORIGINS=

# --- Consulta DNI/RUC (APIINTI) --- Sprint 9
APIINTI_API_KEY=
APIINTI_BASE_URL=

# --- Telegram --- Sprint 9
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Respaldo cifrado --- Sprint 9
BACKUP_ENC_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# --- Almacenamiento alterno S3/R2 (opcional) ---
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- IA (solo si se aprueba D3) --- Sprint 12
AI_PROVIDER=
AI_API_KEY=

# --- Observabilidad (opcional) ---
SENTRY_DSN=
